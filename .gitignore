# =============================================================================
# .gitignore — pgd-ocde-icmbio
# Atualizado em 21.06.2026
# Princípio: tudo que contenha credenciais, dados pessoais, caminhos locais
# ou artefatos operacionais não publicáveis deve estar aqui.
# =============================================================================

# -----------------------------------------------------------------------------
# Credenciais e configuração local (NUNCA versionar)
# -----------------------------------------------------------------------------
.env
.env.local
*.local
.secrets.baseline

# -----------------------------------------------------------------------------
# Instruções e memória dos agentes locais (contêm credenciais e contexto privado)
# -----------------------------------------------------------------------------
CLAUDE.md
AGENTS.md
.claude
.claude/
.codex
.codex/

# -----------------------------------------------------------------------------
# Antigravity Desktop — agentes e metadados do projeto (uso local)
# -----------------------------------------------------------------------------
.agents
.agents/
PROJECT.md

# -----------------------------------------------------------------------------
# Skills locais (desenvolvimento interno — não sincronizar com GitHub)
# ATENÇÃO: ignora-se apenas .github/skills/. O restante de .github/ é público e
# versionado — .github/workflows/quality.yml é o CI que roda pytest e
# tools/security_audit.py nas PRs. Não acrescentar ".github/" a este arquivo.
# -----------------------------------------------------------------------------
.github/skills/
instalar_skill_*.ps1

# -----------------------------------------------------------------------------
# Backups locais de skills gerados por tools/skills_manager.py
# -----------------------------------------------------------------------------
.skills-backups/

# -----------------------------------------------------------------------------
# Dumps do banco PETRVS (nunca versionar — arquivo > 4 GB com dados pessoais)
# -----------------------------------------------------------------------------
*.sql
*.sql.gz
*.sql.zip
_dump/
dump/

# -----------------------------------------------------------------------------
# Artefatos locais — CSVs mensais, diagnósticos, validações, backup de scripts
# Estrutura atual (caminhos gerenciados por lib/csv_utils.py):
#   artefatos_local/
#     ocde/
#       entregas/YYYY-MM/        ← CSVs mensais para entrega à COCAGE/Power BI
#       diagnosticos/YYYY-MM/    ← Scripts A4 e CSVs diagnósticos (uso interno)
#     validacao/                 ← Relatórios A5 (.md) e PDFs de consulta A3
#     docs_internos/             ← Documentação local não publicável
#     historico/                 ← Artefatos legados (dump mai-2026, denodo mai-2026)
#     backup_scripts_a1/         ← Cópias de segurança dos scripts A1
# -----------------------------------------------------------------------------
artefatos_local/
artefatos_local

# -----------------------------------------------------------------------------
# Pastas legadas (migradas para artefatos_local/ em 17.06.2026 — mantidas aqui
# por segurança caso ressurjam localmente)
# -----------------------------------------------------------------------------
Tabelas CSV/
Testes PETRVS/

# -----------------------------------------------------------------------------
# Dados brutos exportados — podem conter dados pessoais de servidores
# -----------------------------------------------------------------------------
*.csv
*.xlsx
*.xls

# Exceção: fixtures sintéticas de teste (sem dados reais, versionadas propositalmente)
!tests/fixtures/**/*.csv

# -----------------------------------------------------------------------------
# Apresentações e PDFs (podem conter dados operacionais sensíveis)
# -----------------------------------------------------------------------------
*.pdf
*.pptx
*.ppt

# -----------------------------------------------------------------------------
# Notebooks Jupyter (podem conter credenciais e resultados de consultas)
# Exceção: o template público não tem credenciais e serve de referência para a APF
# -----------------------------------------------------------------------------
*.ipynb
!consultas_denodo_template.ipynb

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# -----------------------------------------------------------------------------
# Caches das ferramentas de teste (regeneráveis — nunca versionar)
# Observação: config/ NÃO é ignorado; config/validation-baselines.example.json é
# o template público do protocolo de homologação e deve permanecer versionado.
# -----------------------------------------------------------------------------
.pytest_cache/
.hypothesis/

# -----------------------------------------------------------------------------
# Logs de execução
# -----------------------------------------------------------------------------
*.log

# -----------------------------------------------------------------------------
# VS Code — configurações locais (settings globais são versionados via settings.json)
# -----------------------------------------------------------------------------
.vscode/settings.local.json

# -----------------------------------------------------------------------------
# Arquivo de workspace do VS Code (contém caminhos absolutos locais)
# -----------------------------------------------------------------------------
*.code-workspace

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
/NUL
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Documentos de planejamento interno (arquitetura, roadmap, decisões técnicas)
# -----------------------------------------------------------------------------
plano_estrutura_projeto.md

# -----------------------------------------------------------------------------
# Análises e iniciativas internas CGOV (privadas — OneDrive, nunca GitHub)
# O diretório cgov/ é acessado via Junction apontando para o OneDrive.
# docs/cgov/ permanece público (apenas README placeholder sem análises).
# -----------------------------------------------------------------------------
/cgov/
/cgov

# -----------------------------------------------------------------------------
# Scripts de configuração de ambiente local (contêm caminhos e lógica locais)
# Acessados via Junction apontando para o OneDrive.
# -----------------------------------------------------------------------------
/setup/
/setup

# -----------------------------------------------------------------------------
# Pasta aninhada criada em sessão anterior (pode ser deletada manualmente)
# -----------------------------------------------------------------------------
/DM_Petrvs_icmbio_mysql/

# ─── Agente de gestão (incorporado no L3; ex-pgd-agente-icmbio) ───────────────
# Dados locais do agente: não migram pelo Git (inventário privado no L6).
data/
agente/data/
testes_cgov/
agente/testes_cgov/
*.pyc
*.ipynb_checkpoints/
.pytest_cache/
# Exceção SQL restrita (plano §5): só o schema e as migrações numeradas do agente.
!agente/dados/schema.sql
!agente/dados/migracoes/
!agente/dados/migracoes/[0-9][0-9][0-9]_*.sql
# Dumps continuam recusados mesmo dentro da exceção.
*.dump.sql
agente/dados/**/pgd_agente_*.sql
agente/dados/pgd_agente_*.sql
# Acervo de referências: só o README é público (raiz e local intermediário do L3).
docs/referencias-pgd/**
!docs/referencias-pgd/README.md
agente/docs/referencias-pgd/**
!agente/docs/referencias-pgd/README.md
