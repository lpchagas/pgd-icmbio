# Copie para .env e preencha os valores reais. O .env NUNCA é versionado.

# API do modelo (Trilha T, I1)
ANTHROPIC_API_KEY=cole-a-chave-aqui

# MySQL local — modelo comum de dados (v4 §3.2 / ADR-006, D4)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pgd_agente
MYSQL_USER=pgd_agente
MYSQL_PASSWORD=defina-a-senha-local

# Denodo (MGI/Dataprev) — acesso somente leitura ao PETRVS (v4 §7 / AT-01 §7)
DENODO_URL=jdbc:denodo://denodo-pgd.dataprev.gov.br:443/petrvs_icmbio
DENODO_USER=cpf-do-usuario
DENODO_PASS=defina-a-senha
DENODO_JDBC_JAR=caminho\para\denodo-vdp-jdbcdriver.jar
DENODO_JVM_DLL=caminho\para\jvm.dll
