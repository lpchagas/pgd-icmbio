# Copie para .env e preencha os valores reais. O .env NUNCA é versionado.

# API do modelo (Trilha T, I1)
ANTHROPIC_API_KEY=cole-a-chave-aqui

# MySQL local — modelo comum de dados (v4 §3.2 / ADR-006, D4)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pgd_agente
MYSQL_USER=pgd_agente
MYSQL_PASSWORD=defina-a-senha-local
