# Credenciais de acesso ao Denodo — copie este arquivo como .env e preencha com seus dados
# NUNCA commitar o arquivo .env — ele contém sua senha pessoal
#
# Como usar (Linux/WSL, ambiente principal):
#   1. Copie este arquivo:  cp .env.example .env && chmod 600 .env
#   2. Abra o .env num editor (ex.: nano .env)
#   3. Preencha DENODO_USER e DENODO_PASSWORD e confira os caminhos de Java e driver
#   4. Salve — pronto
# No Windows, use o bloco "Windows" comentado abaixo no lugar do bloco Linux/WSL.

# ─── Java (JVM do mesmo sistema que roda o Python) ────────────────────────────
# Linux/WSL: JDK da distribuição (ex.: sudo apt install openjdk-21-jre-headless).
# O Python do WSL não carrega a JVM do Windows: aponte DENODO_JVM_DLL para libjvm.so.
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
DENODO_JVM_DLL=/usr/lib/jvm/java-21-openjdk-amd64/lib/server/libjvm.so

# ─── Driver Denodo ────────────────────────────────────────────────────────────
# Arquivo .jar JDBC da Denodo, fora do repositório (*.jar não é ignorado pelo Git).
# Como obter: docs/ambiente/acesso-denodo-dbeaver.md (o download automático pode
# trazer o pacote ODBC por engano).
DENODO_DRIVER_PATH=/home/SEU_USUARIO/.local/share/denodo/jdbc/9/denodo-vdp-jdbcdriver.jar

# ─── Windows (alternativa) ────────────────────────────────────────────────────
# Java instalado pelo DBeaver (a jvm.dll é derivada de JAVA_HOME) e driver em pasta
# fixa. Para descobrir seu usuário: no Prompt de Comando, digite  echo %USERNAME%
# JAVA_HOME=C:/Program Files/DBeaver/jre
# DENODO_DRIVER_PATH=C:/Users/SEU_USUARIO/drivers/denodo/denodo-vdp-jdbcdriver.jar

# ─── Conexão Denodo ───────────────────────────────────────────────────────────
# Não alterar — são os dados fixos do servidor do governo (Dataprev/MGI)
DENODO_HOST=denodo-pgd.dataprev.gov.br
DENODO_PORT=443
DENODO_DATABASE=petrvs_icmbio

# ─── Suas credenciais individuais ─────────────────────────────────────────────
# Fornecidas pelo gestor responsável pelo PGD no seu órgão.
# DENODO_USER: seu CPF sem pontos, traço ou dígito verificador (11 dígitos)
DENODO_USER=seu_cpf_aqui
DENODO_PASSWORD=sua_senha_aqui

# ─── Agente de gestão (agente/dados) ──────────────────────────────────────────
# MySQL local do modelo comum (auxiliar; não é datamart).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pgd_agente
MYSQL_USER=pgd_agente
MYSQL_PASSWORD=defina-a-senha-local

# API do modelo de linguagem (só para capacidades do agente que a usem).
ANTHROPIC_API_KEY=cole-a-chave-aqui

# Nomes antigos do agente, aceitos temporariamente como aliases (ADR-012):
#   DENODO_PASS     -> DENODO_PASSWORD      (se os dois existirem com valores diferentes: erro)
#   DENODO_JDBC_JAR -> DENODO_DRIVER_PATH
#   DENODO_URL      -> DENODO_HOST, DENODO_PORT, DENODO_DATABASE
#                      (jdbc:denodo://host:porta/base; parâmetros extras são recusados)
# Prefira os nomes canônicos acima. DENODO_JVM_DLL já é canônica.
